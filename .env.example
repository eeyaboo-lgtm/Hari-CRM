# Copy to .env.local for local dev. Never commit the real .env.local.
# Set these same names as environment variables on Render/Vercel for production —
# never hardcode them in code (see SECURITY.md section 6).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Smart alerts email digest (app/api/alerts/notify/route.ts) — all optional,
# the route is a safe no-op until these are set. See HANDOVER.md "Smart
# alerts setup" for the exact steps (Resend account + verified domain +
# free external cron).
RESEND_API_KEY=
ALERTS_FROM_EMAIL=
ALERTS_CRON_SECRET=
